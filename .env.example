DS_HOST=127.0.0.1
DS_PORT=8765
DS_DEBUG=0
DS_DATA_DIR=./data
# Optional: put encrypted Vault objects on the storage HDD. Empty = ./data/vault
DS_VAULT_ROOT=

# Safety gates. File writes can also be enabled temporarily from the UI and
# remain in backend RAM until disabled or the backend restarts.
DS_ALLOW_FILE_WRITES=0
DS_ALLOW_VAULT_WRITES=0

# Optional GLOBAL disk-write override. Leave 0 for normal operation.
# A selected non-protected physical disk can be WRITE-enabled from the UI.
# Permission is identity-bound and lasts until manual disable or backend restart.
DS_ALLOW_DISK_WRITES=0

# Experimental NTFS extent relocation remains disabled.
DS_ALLOW_EXTENT_MOVES=0

# Optional storage policy defaults.
DS_SOFT_FILL_LIMIT=0.85
DS_HARD_FILL_LIMIT=0.95
DS_RESERVE_FRACTION=0.05

# Optional face models (OpenCV YuNet / SFace ONNX paths).
DS_FACE_DETECTOR_MODEL=
DS_FACE_RECOGNIZER_MODEL=
